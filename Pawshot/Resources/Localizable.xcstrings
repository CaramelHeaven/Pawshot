      }
    },
    "Kept on this Mac only, for the last three days. Nothing leaves it until you send it: as a file, or by email to the developer." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранятся только на этом Mac, за последние три дня. Никуда не уходят, пока вы сами их не отправите: файлом или письмом разработчику."
          }
        }
      }
    },
