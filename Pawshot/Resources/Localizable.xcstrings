            "value" : "Чтобы остановить, нажмите то же сочетание ещё раз."
          }
        }
      }
    },
    "Pressed shortcuts" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатые сочетания"
          }
        }
