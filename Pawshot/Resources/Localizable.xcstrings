      }
    },
    "Missed? Drag the editor window's edge." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промахнулись? Потяните край окна редактора."
          }
        }
      }
    },
    "Move focus to next window" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместить фокус на следующее окно"
