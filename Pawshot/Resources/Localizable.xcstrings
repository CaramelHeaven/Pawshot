          }
        }
      }
    },
    "Every shortcut goes back to the one Pawshot came with." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сочетания вернутся к тем, что были в Pawshot изначально."
          }
        }
      }
    },
    "Eyedropper" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
