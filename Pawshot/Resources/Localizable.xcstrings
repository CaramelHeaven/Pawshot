      }
    },
    "An artist." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Художник."
          }
        }
      }
    },
    "Arrow (A)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стрелка (A)"
          }
        }
      }
