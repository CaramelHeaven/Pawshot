          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешено"
          }
        }
      }
    },
    "Allow…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить…"
          }
        }
      }
    },
    "Almost quit, let go just in time." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чуть не вышли, но отпустили вовремя."
