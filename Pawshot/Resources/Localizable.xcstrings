          }
        }
      }
    },
    "Fill: none, 30%, 60%, solid (F)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заливка: нет, 30%, 60%, сплошная (F)"
